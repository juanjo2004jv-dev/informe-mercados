<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mercado eléctrico · semana {{ semana_num }} de {{ anio }}</title>
<style>
:root{
  --bg:#eef1f3; --panel:#e4e9ec; --ink:#13212c; --muted:#556772; --rule:#c8d2d8;
  --teal:#1f7a8c; --amber:#b9751a; --red:#b23a48;
  --font-body: system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --font-head: "Iowan Old Style","Palatino Linotype",Palatino,"Book Antiqua",Georgia,serif;
}
@media (prefers-color-scheme: dark){
  :root{ --bg:#0f1a22; --panel:#16252f; --ink:#e4ebf0; --muted:#93a4b0; --rule:#26363f; --teal:#5cc0d3; --amber:#e3a550; --red:#e0707d; }
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 var(--font-body);font-variant-numeric:tabular-nums}
a{color:var(--teal)}
a:focus-visible,button:focus-visible{outline:2px solid var(--teal);outline-offset:2px}
.wrap{display:grid;grid-template-columns:300px minmax(0,1fr);gap:0 56px;max-width:1280px;margin:0 auto;padding:0 28px}
.rail{position:sticky;top:0;align-self:start;height:100vh;padding:44px 0 32px;display:flex;flex-direction:column;gap:22px;overflow:auto}
.rail h1{font:600 30px/1.15 var(--font-head);margin:0;letter-spacing:-.01em}
.rail .rango{color:var(--muted);margin:4px 0 0}
.rail .veredicto{font:400 17px/1.5 var(--font-head);margin:0;padding-top:18px;border-top:1px solid var(--rule)}
.rail nav{display:flex;flex-direction:column;gap:6px;font-size:14px}
.rail nav a{color:var(--muted);text-decoration:none}
.rail nav a:hover{color:var(--ink)}
.rail .pie{margin-top:auto;color:var(--muted);font-size:12.5px}
main{padding:44px 0 80px;min-width:0}
.aviso{background:var(--panel);border-left:3px solid var(--amber);padding:10px 14px;margin:0 0 28px;font-size:14px}
.cinta{display:flex;flex-wrap:wrap;gap:18px 0;margin:0 0 44px;border-top:1px solid var(--ink);border-bottom:1px solid var(--rule)}
.cinta div{flex:1 1 150px;padding:14px 18px 14px 0;margin-right:18px;border-right:1px solid var(--rule)}
.cinta div:last-child{border-right:0}
.cinta dt{font-size:13px;color:var(--muted);margin:0}
.cinta dd{margin:2px 0 0;font:600 26px/1.15 var(--font-head)}
.cinta .sub{font:400 13px var(--font-body);color:var(--muted)}
.pos{color:var(--teal)} .neg{color:var(--red)}
section{margin:0 0 64px}
section h2{font:600 24px/1.25 var(--font-head);margin:0 0 8px;max-width:30em;letter-spacing:-.005em}
section p{max-width:62ch;margin:0 0 18px;color:var(--ink)}
section p.nota{color:var(--muted);font-size:14px}
.graf{margin:10px 0 0;border-top:1px solid var(--rule);padding-top:8px}
table{border-collapse:collapse;width:100%;max-width:760px;font-size:14.5px}
th,td{padding:7px 12px 7px 0;border-bottom:1px solid var(--rule);text-align:right}
th:first-child,td:first-child{text-align:left}
th{font-weight:600;color:var(--muted);font-size:13px}
.tabla-scroll{overflow-x:auto}
.pdfbtn{display:inline-block;background:var(--teal);color:#fff;padding:8px 16px;border-radius:6px;text-decoration:none;font-size:14px;font-weight:600}
.cta{margin:-22px 0 40px}
figure.pag{margin:0 0 26px}
figure.pag img{width:100%;height:auto;display:block;border:1px solid var(--rule);border-radius:4px;background:#fff}
figure.pag figcaption{font-size:12.5px;color:var(--muted);margin-top:4px}
@media (max-width:900px){
  .wrap{grid-template-columns:1fr;padding:0 18px}
  .rail{position:static;height:auto;padding:28px 0 8px}
  .rail nav{flex-direction:row;flex-wrap:wrap;gap:6px 16px}
  .rail .pie{display:none}
  main{padding-top:12px}
  .cinta div{flex-basis:45%}
}
@media print{
  .rail{position:static;height:auto} .rail nav{display:none}
  .wrap{display:block} section{break-inside:avoid}
}
</style>
</head>
<body>
<div class="wrap">
<aside class="rail">
  <div>
    <h1>Mercado eléctrico, semana {{ semana_num }}</h1>
    <p class="rango">{{ rango }}</p>
  </div>
  <p class="veredicto">{{ t.titular }}</p>
  <nav aria-label="Secciones">
    <a href="#calor">Mapa de precios</a>
    <a href="#bateria">Arbitraje de baterías</a>
    <a href="#perfil">Forma del día</a>
    {% if res.extras %}<a href="#mercados">Otros mercados</a>{% endif %}
    {% if res.captura %}<a href="#captura">Precio capturado</a>{% endif %}
    {% if res.demanda %}<a href="#demanda">Demanda</a>{% endif %}
    {% if res.mix %}<a href="#mix">Mix y renovables</a>{% endif %}
    {% if res.baterias or res.i3_resumen %}<a href="#baterias-sistema">Baterías del sistema</a>{% endif %}
    <a href="#tendencia">Tendencia</a>
    {% if esenciales %}<a href="#almacenamiento">Más para almacenamiento</a>{% endif %}
    {% if pdf_url %}<a href="{{ pdf_url }}">PDF completo{% if npag %} ({{ npag }} págs.){% endif %}</a>{% endif %}
    <a href="#metodo">Datos y método</a>
    <a href="{{ base }}archivo.html">Semanas anteriores</a>
  </nav>
  <div class="pie">Generado el {{ generado }}.<br>Fuente: ESIOS (REE) y OMIE.</div>
</aside>

<main>
{% if demo %}<p class="aviso"><strong>Datos sintéticos de prueba.</strong> Este informe sirve para comprobar el diseño; las cifras no son reales.</p>{% endif %}
{% if res.provisional and not demo %}<p class="aviso"><strong>Edición provisional.</strong> Mercados, servicios de balance, mix y baterías están completos. {% if res.i3_anterior %}La liquidación por tecnología y las restricciones técnicas (I3 de REE) del PDF son de la semana anterior: se sustituyen solas por las de esta semana cuando REE publica los siete días, entre el jueves y el viernes.{% else %}La liquidación por tecnología y las restricciones técnicas (I3 de REE) se añaden solas cuando REE publica los siete días, entre el jueves y el viernes.{% endif %}</p>{% endif %}

<dl class="cinta">
  <div><dt>Precio medio</dt><dd>{{ res.precio_medio|n }} <span class="sub">€/MWh</span></dd>
    <span class="sub {{ 'neg' if res.var_prev < 0 else 'pos' }}">{{ res.var_prev|n(1,True) }} % vs semana anterior</span></div>
  <div><dt>Rango de precios</dt><dd>{{ res.precio_min|n(1) }} a {{ res.precio_max|n(0) }}</dd><span class="sub">€/MWh, por cuarto de hora</span></div>
  <div><dt>Spread diario medio</dt><dd>{{ res.spread_medio|n(0) }} <span class="sub">€/MWh</span></dd><span class="sub">máx. − mín. del día</span></div>
  <div><dt>Horas a precio ≤ 0</dt><dd>{{ res.horas_neg|n(1) }} <span class="sub">h</span></dd><span class="sub">mínimo {{ res.precio_min|n(1) }} €/MWh</span></div>
  <div><dt>Techo de arbitraje</dt><dd>{{ res.bess_dia|n(0) }} <span class="sub">€/MW·día</span></dd><span class="sub">batería {{ bat.horas|int }} h</span></div>
  {% if res.captura.gen_solar_fv %}<div><dt>Solar capturó</dt><dd>{{ res.captura.gen_solar_fv.ratio|n(0) }} <span class="sub">% del precio medio</span></dd><span class="sub">{{ res.captura.gen_solar_fv.precio|n(1) }} €/MWh</span></div>{% endif %}
  {% if res.mix %}<div><dt>Renovables</dt><dd>{{ res.mix.renovable_pct|n(0) }} <span class="sub">% de la generación</span></dd><span class="sub">máx. {{ res.mix.renovable_max|n(0) }} % en un cuarto</span></div>{% endif %}
  {% if res.multimercado %}<div><dt>Techo con intradiarios</dt><dd>{{ res.multimercado.media|n(0) }} <span class="sub">€/MW·día</span></dd><span class="sub">{{ res.multimercado.uplift|n(0,True) }} % sobre solo diario</span></div>{% endif %}
  {% if res.baterias and res.baterias.spread == res.baterias.spread %}<div><dt>Spread de las baterías</dt><dd>{{ res.baterias.spread|n(0) }} <span class="sub">€/MWh</span></dd><span class="sub">capturado por el parque real</span></div>{% endif %}
</dl>

{% if pdf_url %}<p class="cta"><a class="pdfbtn" href="{{ pdf_url }}">Descargar el informe completo en PDF{% if npag %} · {{ npag }} páginas{% endif %}</a> <span class="sub" style="color:var(--muted);font-size:13px">{% if res.provisional %}edición provisional: {% if res.i3_anterior %}I3 de la semana anterior, se actualiza solo{% else %}el I3 se añade cuando REE lo publica{% endif %}{% else %}incluye I3 por tecnología, restricciones técnicas y operación reforzada{% endif %}</span></p>{% endif %}

<section id="calor">
  <h2>{{ t.h_calor }}</h2>
  <p>{{ t.p_calor }}</p>
  <div class="graf"><div id="g_calor"></div></div>
  <p class="nota">Los puntos oscuros marcan cuándo cargaría una batería óptima y los blancos cuándo descargaría (cálculo en la sección siguiente).</p>
</section>

<section id="bateria">
  <h2>{{ t.h_bess }}</h2>
  <p>{{ t.p_bess }}</p>
  <div class="graf"><div id="g_bess"></div></div>
  <p class="nota">Techo teórico para 1 MW / {{ bat.horas|int }} MWh, rendimiento de ida y vuelta del {{ (bat.rendimiento_ida_vuelta*100)|int }} %, tope de {{ bat.ciclos_max_dia|n(1) }} ciclos al día y coste de ciclado de {{ bat.coste_ciclado_eur_mwh|n(0) }} €/MWh, solo con precios del mercado diario y previsión perfecta, empezando y terminando cada día vacía. No incluye aFRR, mFRR ni intradiarios, y no es un ingreso garantizado: es la cota máxima del arbitraje en este mercado.</p>
  {% set mm = res.multimercado %}{% set tb = res.tb or {} %}{% set cp = res.comparativa or {} %}
  <div class="tabla-scroll"><table>
    <thead><tr><th>Indicador para baterías</th><th>Esta semana</th>{% if cp.anterior %}<th>Misma semana {{ cp.anterior.etiqueta[:4] }}</th>{% endif %}<th>Qué mide</th></tr></thead>
    <tbody>
    <tr><td>Techo de arbitraje · solo diario (4 h)</td><td>{{ res.bess_dia|n(0) }} €/MW·día</td>{% if cp.anterior %}<td>{{ cp.anterior.bess_4h|n(0) }} €/MW·día</td>{% endif %}<td>Máximo con previsión perfecta en el diario</td></tr>
    {% if mm %}<tr><td>Techo con diario + IDA1-3 (4 h)</td><td>{{ mm.media|n(0) }} €/MW·día <span class="sub">({{ mm.uplift|n(0,True) }} %)</span></td>{% if cp.anterior %}<td>—</td>{% endif %}<td>Reoptimizando con el mejor precio de cada cuarto entre diario e intradiarios</td></tr>{% endif %}
    {% for k in [1, 2, 4] %}{% if tb.get(k) == tb.get(k) and tb.get(k) is not none %}<tr><td>Spread TB{{ k }}</td><td>{{ tb.get(k)|n(0) }} €/MWh</td>{% if cp.anterior %}<td>{% if k == 4 and cp.anterior.tb4 == cp.anterior.tb4 %}{{ cp.anterior.tb4|n(0) }} €/MWh{% else %}—{% endif %}</td>{% endif %}<td>{% if k == 1 %}Hora más cara menos hora más barata de cada día{% else %}Media de las {{ k }} h más caras menos las {{ k }} más baratas de cada día{% endif %}</td></tr>{% endif %}{% endfor %}
    {% if cp.anterior %}<tr><td>Precio medio del diario</td><td>{{ res.precio_medio|n(1) }} €/MWh</td><td>{{ cp.anterior.precio_medio|n(1) }} €/MWh</td><td>Media de los cuartos de hora</td></tr>{% endif %}
    {% if cp.ytd %}<tr><td>Techo acumulado en el año (4 h)</td><td>{{ (cp.ytd/1000)|n(1) }} k€/MW <span class="sub">{{ cp.ytd_semanas }} semanas</span></td>{% if cp.anterior %}<td>{% if cp.ytd_prev %}{{ (cp.ytd_prev/1000)|n(1) }} k€/MW{% else %}—{% endif %}</td>{% endif %}<td>Suma de los techos semanales del año</td></tr>{% endif %}
    </tbody></table></div>
  {% if cp.anterior %}<p class="nota" style="margin-top:10px">Hasta el 30 de septiembre de 2025 el mercado diario era horario: el techo de arbitraje de esas semanas sale algo más bajo que con precios cuartohorarios.</p>{% endif %}
</section>

<section id="perfil">
  <h2>Así fue el día tipo frente a las cuatro semanas anteriores</h2>
  <p>La diferencia entre la curva de esta semana y la de referencia indica si el valle del mediodía se profundiza o la punta de la tarde se estrecha.</p>
  <div class="graf"><div id="g_perfil"></div></div>
</section>

{% if res.extras %}
<section id="mercados">
  <h2>Cómo se desvían el resto de mercados respecto al diario</h2>
  <div class="tabla-scroll"><table>
    <thead><tr><th>Mercado</th><th>Media €/MWh</th><th>Mín</th><th>Máx</th><th>Dif. vs diario</th></tr></thead>
    <tbody>
    <tr><td>Mercado diario</td><td>{{ res.precio_medio|n }}</td><td>{{ res.precio_min|n }}</td><td>{{ res.precio_max|n }}</td><td>—</td></tr>
    {% for e in res.extras %}<tr><td>{{ e.nombre }}</td><td>{{ e.media|n }}</td><td>{{ e.min|n }}</td><td>{{ e.max|n }}</td><td>{{ e.dif|n(1,True) }}</td></tr>{% endfor %}
    </tbody></table></div>
  <div class="graf"><div id="g_merc"></div></div>
</section>
{% endif %}

{% if res.captura %}
<section id="captura">
  <h2>{{ t.h_solar if t.h_solar else 'Precio capturado por tecnología' }}</h2>
  <p>{{ t.p_solar }}</p>
  <div class="tabla-scroll"><table>
    <thead><tr><th>Tecnología</th><th>Precio capturado €/MWh</th><th>% del precio medio</th><th>Energía GWh</th></tr></thead>
    <tbody>
    {% if res.captura.gen_solar_fv %}<tr><td>Solar fotovoltaica</td><td>{{ res.captura.gen_solar_fv.precio|n }}</td><td>{{ res.captura.gen_solar_fv.ratio|n(0) }} %</td><td>{{ res.captura.gen_solar_fv.energia_gwh|n(1) }}</td></tr>{% endif %}
    {% if res.captura.gen_eolica %}<tr><td>Eólica</td><td>{{ res.captura.gen_eolica.precio|n }}</td><td>{{ res.captura.gen_eolica.ratio|n(0) }} %</td><td>{{ res.captura.gen_eolica.energia_gwh|n(1) }}</td></tr>{% endif %}
    </tbody></table></div>
  <p class="nota" style="margin-top:14px">Calculado con generación en tiempo real de ESIOS y precio del mercado diario. Es una aproximación: no es el ingreso liquidado (I3).</p>
</section>
{% endif %}

{% if res.demanda %}
<section id="demanda">
  <h2>{{ t.h_dem }}</h2>
  <p>{{ t.p_dem }}</p>
  <div class="graf"><div id="g_dem"></div></div>
</section>
{% endif %}

{% if res.mix %}
<section id="mix">
  <h2>Mix de generación: las renovables cubrieron el {{ res.mix.renovable_pct|n(1) }} %</h2>
  <p>Entre el {{ res.mix.renovable_min|n(0) }} % y el {{ res.mix.renovable_max|n(0) }} % según el momento.{% if res.mix.horas_ren_demanda == res.mix.horas_ren_demanda %} Durante {{ res.mix.horas_ren_demanda|n(1) }} h la generación renovable superó a toda la demanda peninsular: horas en las que sobra energía y una batería carga barato.{% endif %}{% if res.mix.saldo_intercambios_gwh is defined %} Saldo con el exterior: {{ 'exportación' if res.mix.saldo_intercambios_gwh < 0 else 'importación' }} neta de {{ res.mix.saldo_intercambios_gwh|abs|n(0) }} GWh.{% endif %}{% if res.mix.hueco_txt %} ESIOS no publicó la generación en tiempo real {{ res.mix.hueco_txt }} ({{ res.mix.hueco_h|n(1) }} h): las energías de la semana no incluyen {{ 'esos tramos' if ' y ' in res.mix.hueco_txt else 'ese tramo' }}.{% endif %}</p>
  <div class="graf"><div id="g_mix"></div></div>
  <div class="tabla-scroll"><table>
    <thead><tr><th>Tecnología</th><th>GWh</th><th>% de la generación</th></tr></thead>
    <tbody>{% for k, v in res.mix.gwh.items() %}{% if v > 0.05 %}<tr><td>{{ res.mix.nombres.get(k, k) }}{% if k in res.mix.renovables %} · renovable{% endif %}</td><td>{{ v|n(0) }}</td><td>{{ res.mix.cuota[k]|n(1) }} %</td></tr>{% endif %}{% endfor %}</tbody>
  </table></div>
  <p class="nota" style="margin-top:14px">Generación peninsular en tiempo real (ESIOS). Hidráulica convencional = hidráulica neta − turbinación − consumo de bombeo; la turbinación de bombeo cuenta como no renovable.</p>
</section>
{% endif %}

{% if res.baterias or res.i3_resumen %}
<section id="baterias-sistema">
  <h2>Qué hicieron las baterías del sistema</h2>
  {% if res.baterias %}<p>El parque peninsular cargó {{ res.baterias.mwh_carga|n(0) }} MWh y entregó {{ res.baterias.mwh_entrega|n(0) }} MWh (rendimiento aparente {{ res.baterias.rendimiento|n(0) }} %). Cargó de media a {{ res.baterias.precio_carga|n(1) }} €/MWh y descargó a {{ res.baterias.precio_descarga|n(1) }} €/MWh: un spread capturado de {{ res.baterias.spread|n(1) }} €/MWh. Potencia máxima observada: {{ res.baterias.mw_max_entrega|n(0) }} MW entregando y {{ res.baterias.mw_max_carga|n(0) }} MW cargando.</p>
  <div class="graf"><div id="g_bat"></div></div>{% endif %}
  {% if res.i3_resumen %}{% set g = res.i3_resumen['Almacenamiento generación'] %}{% set c = res.i3_resumen['Almacenamiento consumo'] %}
  <div class="tabla-scroll"><table>
    <thead><tr><th>Según la liquidación (I3)</th><th>Energía final (P48)</th><th>Importe</th><th>€/MWh</th></tr></thead>
    <tbody>
      <tr><td>Venta (almacenamiento generación)</td><td>{{ g.p48_mwh|n(0) }} MWh</td><td>{{ g.ingreso|n(0) }} €</td><td>{{ res.i3_resumen.precio_venta|n(1) }}</td></tr>
      <tr><td>Compra (almacenamiento consumo)</td><td>{{ c.p48_mwh|abs|n(0) }} MWh</td><td>{{ c.ingreso|n(0) }} €</td><td>{{ res.i3_resumen.precio_compra|n(1) }}</td></tr>
    </tbody></table></div>
  <p class="nota">En el I3, «almacenamiento consumo» suma más energía que la que cargan las baterías en tiempo real; por eso no se resta compra de venta ni se da un resultado neto.</p>{% else %}<p class="nota">La liquidación por mercado (I3) de las baterías se añade cuando REE la publica, entre el jueves y el viernes.</p>{% endif %}
  <p class="nota" style="margin-top:14px">Tiempo real: indicadores 2166 (carga) y 2167 (entrega) de ESIOS, valorados al precio del diario. No es la liquidación: esa sale del I3.</p>
</section>
{% endif %}

<section id="tendencia">
  {% if charts.g_hist %}<h2>La semana en perspectiva</h2>
  <p>Cada semana calculada con el mismo método: precio medio, techo de arbitraje de una batería de 4 h y captura de la solar. Lo que paga a una batería es la forma del día, no el nivel del precio.</p>
  <div class="graf"><div id="g_hist"></div></div>{% else %}<h2>{{ t.h_tend }}</h2>
  <p>Evolución de las últimas semanas. El precio medio y el techo de arbitraje no siempre se mueven juntos: lo que paga la batería es la forma del día, no su nivel.</p>
  <div class="graf"><div id="g_tend"></div></div>{% endif %}
</section>

{% if esenciales %}
<section id="almacenamiento">
  <h2>Más para almacenamiento: servicios de balance, duración y renta de cada tecnología</h2>
  <p>Lo que completa el arbitraje del diario: cuánto vale cada hora extra de duración, dónde cobra cada mercado respecto al diario{% if res.series.afrr_banda_p_subir is defined and res.series.afrr_banda_p_subir.notna().mean() > 0.3 %}, qué paga la banda de aFRR frente a arbitrar{% endif %}{% if not res.provisional %} y cómo le va a cada tecnología según la liquidación (I3){% elif res.i3_anterior %} y cómo le fue a cada tecnología según la liquidación (I3) de la semana anterior, la última completa{% endif %}.</p>
  {% for p in esenciales %}<figure class="pag"><img loading="lazy" decoding="async" src="{{ base }}paginas/{{ p.img }}" alt="{{ p.titulo }}" width="1333" height="750"><figcaption>{{ p.titulo }}</figcaption></figure>{% endfor %}
</section>
{% endif %}

<section id="metodo">
  <h2>Datos y método</h2>
  <div class="tabla-scroll"><table>
    <thead><tr><th>Serie</th><th>Indicador ESIOS</th><th>Nombre en ESIOS</th><th>Cobertura</th></tr></thead>
    <tbody>
    {% for k, c in res.cobertura.items() %}<tr><td>{{ meta.get(k, {}).get('nombre', k) }}</td><td>{{ meta.get(k, {}).get('id', '—') }}</td><td style="text-align:left">{{ meta.get(k, {}).get('api', '—') }}</td><td>{{ (c*100)|n(1) }} %</td></tr>{% endfor %}
    </tbody></table></div>
  {% for k, m in meta.items() %}{% if m.get('aviso') %}<p class="nota">Aviso en {{ m.nombre }}: {{ m.aviso }}</p>{% endif %}{% endfor %}
  <p class="nota" style="margin-top:14px">Los precios son cuartohorarios (el mercado diario es de 15 minutos desde el 1 de octubre de 2025). Cuando una serie llega con resolución horaria, su valor se repite en los cuatro cuartos. Las horas son locales; los días de cambio de hora tienen 92 o 100 cuartos. Los datos son los publicados en el momento de generar el informe, y ESIOS puede revisarlos después.</p>
  <p class="nota">Las páginas de liquidación por tecnología y restricciones técnicas salen del I3 de REE, que se publica con unos cuatro días de retraso (D+4). El lunes sale una edición provisional y el informe se regenera solo, con todas las secciones, cuando el I3 de la semana está completo.</p>
</section>
</main>
</div>

<script src="https://cdn.plot.ly/plotly-2.35.2.min.js" charset="utf-8"></script>
<script>
const CHARTS = {{ charts|tojson }};
function css(v){ return getComputedStyle(document.documentElement).getPropertyValue(v).trim(); }
function dibujar(){
  const tinta = css('--ink'), regla = css('--rule'), fuente = css('--font-body');
  for (const id of Object.keys(CHARTS)){
    const el = document.getElementById(id);
    if (!el) continue;
    const spec = CHARTS[id];
    const L = Object.assign({}, spec.layout);
    L.paper_bgcolor = 'rgba(0,0,0,0)';
    L.plot_bgcolor = 'rgba(0,0,0,0)';
    L.font = { family: fuente, color: tinta, size: 12 };
    for (const ax of ['xaxis','yaxis','yaxis2']){
      if (L[ax]){
        L[ax] = Object.assign({ gridcolor: regla, zerolinecolor: regla, linecolor: regla }, L[ax]);
      }
    }
    if (!L.xaxis) L.xaxis = { gridcolor: regla, linecolor: regla };
    if (!L.yaxis) L.yaxis = { gridcolor: regla, zerolinecolor: regla, linecolor: regla };
    Plotly.react(el, spec.data, L, { displayModeBar: false, responsive: true });
  }
}
dibujar();
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', dibujar);
</script>
</body>
</html>
